<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title>{{title}}</title>
	<link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			<div id="header">
				<div id="logo">
					<a href="/"><img src="/images/logo.png" alt="LOGO" height="100" width="200"></a>
				</div>

				<div id="navigation">
					<ul>
						<li>
							<a href="/">Home</a>
						</li>

						<li class="selected">
							<a href="/travel">Travel</a>
						</li>

						<li>
							<a href="/rooms.html">Rooms</a>
						</li>

						<li>
							<a href="/meals.html">Meals</a>
						</li>

						<li>
							<a href="/news.html">News</a>
						</li>

						<li>
							<a href="/about.html">About</a>
						</li>

						<li>
							<a href="/contact.html">Contact</a>
						</li>
					</ul>
				</div>
			</div>

			<div id="contents">
				<div class="box">
					<div>
						<div class="body">

							<h1>{{title}}</h1>

							<ul id="sites">

								{{#each trips}}
								<li>
									<a href="/travel">
										<img src="/images/{{image}}" alt="{{name}}">
									</a>

									<h2>
										<a href="/travel">{{name}}</a>
									</h2>

									<p>{{description}}</p>

									<p>{{details}}</p>
								</li>
								{{/each}}

							</ul>

						</div>
					</div>
				</div>
			</div>
		</div>

		<div id="footer">

			<div>

				<ul class="navigation">

					<li>
						<a href="/">Home</a>
					</li>

					<li class="active">
						<a href="/travel">Travel</a>
					</li>

					<li>
						<a href="/rooms.html">Rooms</a>
					</li>

					<li>
						<a href="/meals.html">Meals</a>
					</li>

					<li>
						<a href="/news.html">News</a>
					</li>

					<li>
						<a href="/about.html">About</a>
					</li>

					<li>
						<a href="/contact.html">Contact</a>
					</li>

				</ul>

			</div>

			<p>
				© 2023 by BHACCASYONIZTAS BEACH RESORT.
				All Rights Reserved
			</p>

		</div>
	</div>
</body>
</html>